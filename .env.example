# Copie esse arquivo pra ".env" e preencha com os valores reais.
# O .env nunca vai pro Git - já deixa isso no .gitignore.

# --- Banco de dados (MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NOME=udflow
DB_USUARIO=
DB_SENHA=

# --- Sessão / segurança ---
# String aleatória grande, só pra gerar o pepper usado no hash do
# código de redefinição de senha. Gera uma vez e não muda depois,
# senão os códigos que já foram enviados param de bater.
APP_PEPPER=

# Ambiente: producao ou desenvolvimento
# Em producao a gente esconde erro do PHP na tela e loga em arquivo.
APP_AMBIENTE=desenvolvimento

# --- E-mail (SMTP, pro código de redefinição de senha) ---
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=nao-responda@udlog.online

# --- n8n ---
# Token fixo que o UDFlow manda no header pra autenticar no webhook.
# Cada automação tem sua própria URL (cadastrada em tb_automacoes),
# mas o token de autenticação do n8n pode ser o mesmo pra todas.
N8N_WEBHOOK_TOKEN=

GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions