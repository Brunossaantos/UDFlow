{
    "name": "udlog/udflow",
    "description": "UDFlow - central de automacoes da UDLOG",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "symfony/expression-language": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Udflow\\": "src/"
        },
        "exclude-from-classmap": [
            "src/util/PayloadValidator.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    }
}
